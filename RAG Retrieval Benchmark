longer than the hard cap is split into hard-cap pieces. A lightweight sentence boundary expression is used so the notebook has no hidden NLP tokenizer dependency; abbreviations and unusual biomedical punctuation can therefore affect boundary quality.","metadata":{}},{"id":"cell-014","cell_type":"code","source":"from urllib.parse import quote\n\ndef stable_chunk_id(doc_id, strategy_name, index):\n    return f\"chunk::{quote(strategy_name, safe='')}::{quote(str(doc_id), safe='')}::{index:06d}\"\n\ndef split_sentences(text):\n    text = (text or \"\").strip()\n    if not text:\n        return []\n    return [part.strip() for part in re.split(r\"(?<=[.!?])\\s+|\\n{2,}\", text) if part.strip()]\n\ndef fixed_token_pieces(text, tokenizer, target, overlap):\n    token_ids = tokenizer.encode(text, add_special_tokens=False)\n    step = target - overlap\n    if step <= 0:\n        raise ValueError(\"Chunk overlap must be smaller than chunk target\")\n    parts = []\n    start = 0\n    while start < len(token_ids):\n        stop = min(start + target, len(token_ids))\n        piece = tokenizer.decode(token_ids[start:stop], skip_special_tokens=True, clean_up_tokenization_spaces=False).strip()\n        if piece:\n            parts.append((piece, stop - start))\n        if stop >= len(token_ids):\n            break\n        start += step\n    return parts\n\ndef sentence_token_pieces(text, tokenizer, target, hard_cap):\n    sentences = split_sentences(text)\n    output, current = [], []\n    def flush():\n        nonlocal current\n        if current:\n            merged = \" \".join(current).strip()\n            ids = tokenizer.encode(merged, add_special_tokens=False)\n            decoded = tokenizer.decode(ids, skip_special_tokens=True, clean_up_tokenization_spaces=False).strip()\n            if decoded:\n                output.append((decoded, len(ids)))\n            current = []\n    for sentence in sentences:\n        ids = tokenizer.encode(sentence, add_special_tokens=False)\n        if not ids:\n            continue\n        if len(ids) > hard_cap:\n            flush()\n            output.extend(fixed_token_pieces(sentence, tokenizer, hard_cap, 0))\n        elif not current:\n            current = [sentence]\n            if len(ids) >= target:\n                flush()\n        else:\n            candidate = \" \".join(current + [sentence])\n            if len(tokenizer.encode(candidate, add_special_tokens=False)) > target:\n                flush()\n                current = [sentence]\n                if len(ids) >= target:\n                    flush()\n            else:\n                current.append(sentence)\n    flush()\n    return output\n\ndef chunk_documents(corpus, strategy, tokenizer, hard_cap=384):\n    pieces = []\n    skipped = []\n    for doc_id in sorted(corpus):\n        text = corpus[doc_id][\"text\"]\n        if not text.strip():\n            skipped.append(doc_id)\n            continue\n        if strategy[\"kind\"] == \"fixed\":\n            document_pieces = fixed_token_pieces(text, tokenizer, strategy[\"target\"], strategy[\"overlap\"])\n        elif strategy[\"kind\"] == \"sentence\":\n            document_pieces = sentence_token_pieces(text, tokenizer, strategy[\"target\"], hard_cap)\n        else:\n            raise ValueError(f\"Unknown chunking kind: {strategy['kind']}\")\n        if not document_pieces:\n            skipped.append(doc_id)\n        for index, (chunk_text, token_count) in enumerate(document_pieces):\n            pieces.append({\n                \"chunk_id\": stable_chunk_id(doc_id, strategy[\"name\"], index),\n                \"parent_doc_id\": str(doc_id), \"chunk_index\": index,\n                \"text\": chunk_text, \"token_count\": int(token_count), \"strategy\": strategy[\"name\"],\n            })\n    return pieces, skipped\n\nCHUNKS = {}\nCHUNK_STATS = []\nfor strategy in CFG[\"chunking\"]:\n    start = time.perf_counter()\n    chunk_list, skipped_docs = chunk_documents(CORPUS, strategy, EMBED_TOKENIZER, CFG[\"max_chunk_tokens\"])\n    CHUNKS[strategy[\"name\"]] = chunk_list\n    token_counts = np.asarray([c[\"token_count\"] for c in chunk_list], dtype=int)\n    per_doc_counts = Counter(c[\"parent_doc_id\"] for c in chunk_list)\n    CHUNK_STATS.append({\n        \"strategy\": strategy[\"name\"], \"target_tokens\": strategy[\"target\"], \"overlap_tokens\": strategy[\"overlap\"],\n        \"chunks\": len(chunk_list), \"documents_covered\": len(per_doc_counts), \"documents_skipped\": len(skipped_docs),\n        \"mean_chunks_per_document\": len(chunk_list) / max(1, len(per_doc_counts)),\n        \"mean_chunk_tokens\": float(token_counts.mean()), \"median_chunk_tokens\": float(np.median(token_counts)),\n        \"p95_chunk_tokens\": float(np.percentile(token_counts, 95)), \"max_chunk_tokens\": int(token_counts.max()),\n        \"construction_seconds\": time.perf_counter() - start,\n    })\n    if skipped_docs:\n        print(\"Skipped documents for\", strategy[\"name\"], \":\", len(skipped_docs))\n    assert all(c[\"token_count\"] <= CFG[\"max_chunk_tokens\"] for c in chunk_list)\n    assert len({c[\"chunk_id\"] for c in chunk_list}) == len(chunk_list)\n\nCHUNK_STATS_DF = pd.DataFrame(CHUNK_STATS)\ndisplay(CHUNK_STATS_DF.round(3))\nCHUNK_STATS_DF.to_csv(RES / \"chunking_statistics.csv\", index=False)\nCHUNK_BY_ID = {name: {c[\"chunk_id\"]: c for c in chunk_list} for name, chunk_list in CHUNKS.items()}","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-03T06:54:24.145363Z","iopub.execute_input":"2026-11-03T06:54:24.145794Z","iopub.status.idle":"2026-11-03T06:55:00.016719Z","shell.execute_reply.started":"2026-11-03T06:54:24.145755Z","shell.execute_reply":"2026-11-03T06:55:00.015876Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"               strategy  target_tokens  overlap_tokens  chunks  \\\n0             fixed_128            128               0   11314   \n1   fixed_256_overlap32            256              32  