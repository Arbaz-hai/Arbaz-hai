          | 0/323 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"b96be90e5fab4a0da9b273df2892d655"}},"metadata":{}},{"name":"stdout","text":"Retrieval sweep completed in 5.6 minutes.\n","output_type":"stream"}],"execution_count":9},{"id":"cell-021","cell_type":"markdown","source":"## 11. Retrieval tables, figures, and paired statistics\n\nAll 18 retrieval configurations are scored on the same qrels and the same 323 test queries. The notebook writes the per-query metric rows, macro averages, and per-query rankings. Timing fields separate index-build time from mean query latency; hybrid latency is the sum of lexical scoring, amortized dense query encoding/exact search, and RRF. Reranked end-to-end latency is first-stage latency plus the measured reranker pass.","metadata":{}},{"id":"cell-022","cell_type":"code","source":"RETRIEVAL_CONFIG_ROWS = []\nRETRIEVAL_QUERY_FRAMES = []\nRANKING_PATH = RES / \"retrieval_rankings.jsonl\"\nif RANKING_PATH.exists():\n    RANKING_PATH.unlink()\nwith open(RANKING_PATH, \"w\", encoding=\"utf-8\") as ranking_stream:\n    for config_id, run in sorted(RUNS.items()):\n        query_frame, means = evaluate_rankings(config_id, run)\n        RETRIEVAL_QUERY_FRAMES.append(query_frame)\n        chunk_name, retrieval_name, stage_name = config_id.split(\"__\")\n        timing = RUN_TIMINGS[config_id]\n        index_timing = INDEX_TIMINGS[chunk_name]\n        RETRIEVAL_CONFIG_ROWS.append({\n            \"config_id\": config_id, \"chunking\": chunk_name, \"first_stage_retrieval\": retrieval_name,\n            \"reranking\": stage_name, \"n_queries\": len(query_frame), **means,\n            **timing, \"bm25_index_build_seconds\": index_timing[\"bm25_index_build_seconds\"],\n            \"dense_index_build_seconds\": index_timing[\"dense_index_build_seconds\"],\n            \"dense_sequence_length\": index_timing[\"dense_sequence_length\"],\n        })\n        for qid, rows in run.items():\n            for row in rows:\n                ranking_stream.write(json.dumps({\"config_id\": config_id, **row}, ensure_ascii=False) + \"\\n\")\n\nRETRIEVAL_RESULTS = pd.DataFrame(RETRIEVAL_CONFIG_ROWS).sort_values([\"chunking\", \"first_stage_retrieval\", \"reranking\"]).reset_index(drop=True)\nRETRIEVAL_PER_QUERY = pd.concat(RETRIEVAL_QUERY_FRAMES, ignore_index=True)\nassert len(RETRIEVAL_RESULTS) == 18\nassert len(RETRIEVAL_PER_QUERY) == 18 * len(QUERY_IDS)\nRETRIEVAL_RESULTS.to_csv(RES / \"retrieval_results.csv\", index=False)\nRETRIEVAL_PER_QUERY.to_csv(RES / \"retrieval_metrics_per_query.csv\", index=False)\nRETRIEVAL_RESULTS[ [\"config_id\", \"n_queries\", \"recall_at_1\", \"recall_at_5\", \"recall_at_10\", \"mrr_at_10\", \"ndcg_at_10\", \"map_at_10\", \"mean_query_latency_ms\"] ].round(4)\ndisplay(RETRIEVAL_RESULTS[[\"config_id\", \"n_queries\", \"recall_at_1\", \"recall_at_5\", \"recall_at_10\", \"mrr_at_10\", \"ndcg_at_10\", \"map_at_10\", \"mean_query_latency_ms\"]].round(4))\n\n# Paired confidence intervals and inference for predeclared comparison families.\ndef paired_bootstrap_ci(differences, n_resamples=10000, seed=SEED, alpha=0.05, block=500):\n    differences = np.asarray(differences, dtype=float)\n    differences = differences[np.isfinite(differences)]\n    if differences.size == 0:\n        return (np.nan, np.nan)\n    rng = np.random.default_rng(seed)\n    means = []\n    remaining = n_resamples\n    while remaining > 0:\n        n_now = min(block, remaining)\n        indices = rng.integers(0, differences.size, size=(n_now, differences.size))\n        means.extend(differences[indices].mean(axis=1).tolist())\n        remaining -= n_now\n    return tuple(np.quantile(means, [alpha / 2, 1 - alpha / 2]))\n\ndef holm_adjust(p_values):\n    p_values = np.asarray(p_values, dtype=float)\n    n = len(p_values)\n    order = np.argsort(p_values)\n    adjusted = np.empty(n, dtype=float)\n    running = 0.0\n    for rank, idx in enumerate(order):\n        value = min(1.0, (n - rank) * p_values[idx])\n        running = max(running, value)\n        adjusted[idx] = running\n    return adjusted.tolist()\n\ndef compare_retrieval_pair(family, config_a, config_b, seed_offset=0):\n    a = RETRIEVAL_PER_QUERY[RETRIEVAL_PER_QUERY.config_id == config_a][[\"query_id\", \"ndcg_at_10\"]]\n    b = RETRIEVAL_PER_QUERY[RETRIEVAL_PER_QUERY.config_id == config_b][[\"query_id\", \"ndcg_at_10\"]]\n    merged = a.merge(b, on=\"query_id\", suffixes=(\"_a\", \"_b\"), validate=\"one_to_one\").dropna()\n    diff = (merged[\"ndcg_at_10_b\"] - merged[\"ndcg_at_10_a\"]).to_numpy(dtype=float)\n    if len(diff) == 0:\n        ci = (np.nan, np.nan); p = np.nan; dz = np.nan\n    else:\n        ci = paired_bootstrap_ci(diff, CFG[\"bootstrap\"][\"n_resamples\"], SEED + seed_offset, CFG[\"bootstrap\"][\"alpha\"])\n        p = float(scipy_stats.wilcoxon(diff, zero_method=\"wilcox\", alternative=\"two-sided\").pvalue) if np.any(diff != 0) else 1.0\n        dz = float(diff.mean() / diff.std(ddof=1)) if len(diff) > 1 and diff.std(ddof=1) > 0 else 0.0\n    return {\"family\": family, \"A\": config_a, \"B\": config_b, \"n_paired\": len(diff), \"mean_diff_B_minus_A\": float(np.mean(diff)) if len(diff) else np.nan,\n            \"ci95_lower\": float(ci[0]), \"ci95_upper\": float(ci[1]), \"wilcoxon_p\": p,\n            \"cohens_dz\": dz, \"wins_B\": int((diff > 0).sum()), \"losses_B\": int((diff < 0).sum()), \"ties\": int((diff == 0).sum())}\n\ncomparisons = []\n# Family 1: effect of reranking (3 chunkers × 3 retrievers = 9)\nfor chunk_name in [s[\"name\"] for s in CFG[\"chunking\"]]:\n    for retriever_name in (\"bm25\", \"dense\", \"hybrid\"):\n        comparisons.append(compare_retrieval_pair(\"reranking_effect\", f\"{chunk_name}__{retriever_name}__base\", f\"{chunk_name}__{retriever_name}__reranked\", len(comparisons)))\n# Family 2: hybrid versus each single-source system (3 chunkers × 2 single sources × 2 reranking states = 12)\nfor chunk_name in [s[\"name