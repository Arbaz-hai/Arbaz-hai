ual_md5 != CFG[\"dataset\"][\"expected_md5\"]:\n        raise RuntimeError(f\"NFCorpus archive checksum mismatch: expected {CFG['dataset']['expected_md5']}, got {actual_md5}\")\n    with zipfile.ZipFile(DATASET_ZIP, \"r\") as archive:\n        bad_member = archive.testzip()\n        if bad_member is not None:\n            raise RuntimeError(f\"NFCorpus ZIP CRC failure in member {bad_member}\")\n        archive.extractall(DATASET_DIR)\n    corpus_files = list(DATASET_DIR.rglob(\"corpus.jsonl\"))\n    if not corpus_files:\n        raise FileNotFoundError(\"Official NFCorpus archive did not contain corpus.jsonl\")\n    root = corpus_files[0].parent\n    required_qrels = [root / \"qrels\" / f\"{split}.tsv\" for split in (\"train\", \"dev\", \"test\")]\n    if not (root / \"queries.jsonl\").is_file() or not all(path.is_file() for path in required_qrels):\n        raise FileNotFoundError(f\"NFCorpus archive must contain queries.jsonl and train/dev/test qrels at {root}\")\n    DATASET_PROVENANCE.update({\n        \"archive_md5\": actual_md5, \"archive_sha256\": sha256_file(DATASET_ZIP),\n        \"archive_bytes\": DATASET_ZIP.stat().st_size, \"extracted_root\": str(root),\n        \"downloaded_at_utc\": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec=\"seconds\"),\n    })\n    return root\n\ndef read_jsonl(path):\n    rows = []\n    with open(path, encoding=\"utf-8\") as stream:\n        for line_number, line in enumerate(stream, start=1):\n            if line.strip():\n                try:\n                    rows.append(json.loads(line))\n                except json.JSONDecodeError as exc:\n                    raise ValueError(f\"Invalid JSONL at {path}:{line_number}: {exc}\") from exc\n    return rows\n\nDATASET_IDENTITY_AUDIT = {}\ndef load_nfcorpus_splits(root):\n    corpus_rows = read_jsonl(root / \"corpus.jsonl\")\n    corpus_ids = [str(row[\"_id\"]) for row in corpus_rows]\n    corpus = {}\n    for row, doc_id in zip(corpus_rows, corpus_ids):\n        if doc_id in corpus:\n            continue\n        corpus[doc_id] = {\"title\": str(row.get(\"title\", \"\") or \"\"), \"text\": str(row.get(\"text\", \"\") or \"\")}\n\n    query_rows = read_jsonl(root / \"queries.jsonl\")\n    query_ids = [str(row[\"_id\"]) for row in query_rows]\n    all_queries = {}\n    for row, qid in zip(query_rows, query_ids):\n        if qid not in all_queries:\n            all_queries[qid] = str(row.get(\"text\", \"\") or \"\")\n\n    split_qrels, duplicate_counts = {}, {}\n    for split in (\"train\", \"dev\", \"test\"):\n        qrels, duplicate_qrel_rows = defaultdict(dict), 0\n        with open(root / \"qrels\" / f\"{split}.tsv\", encoding=\"utf-8\", newline=\"\") as stream:\n            reader = csv.DictReader(stream, delimiter=\"\\t\")\n            for row in reader:\n                qid = str(row.get(\"query-id\", row.get(\"query_id\", \"\")))\n                did = str(row.get(\"corpus-id\", row.get(\"corpus_id\", \"\")))\n                grade = int(row.get(\"score\", \"0\"))\n                if not qid or not did:\n                    raise ValueError(f\"Unrecognized NFCorpus {split} qrels header; expected query-id, corpus-id, score\")\n                if did in qrels[qid]:\n                    duplicate_qrel_rows += 1\n                qrels[qid][did] = grade\n        split_qrels[split] = dict(qrels)\n        duplicate_counts[split] = duplicate_qrel_rows\n\n    DATASET_IDENTITY_AUDIT.update({\n        \"duplicate_document_identifiers\": len(corpus_ids) - len(set(corpus_ids)),\n        \"duplicate_query_identifiers\": len(query_ids) - len(set(query_ids)),\n        \"duplicate_query_document_judgments\": duplicate_counts[\"test\"],\n        \"duplicate_train_query_document_judgments\": duplicate_counts[\"train\"],\n        \"duplicate_dev_query_document_judgments\": duplicate_counts[\"dev\"],\n        \"raw_document_rows\": len(corpus_rows), \"raw_query_rows\": len(query_rows),\n    })\n    return corpus, all_queries, split_qrels[\"train\"], split_qrels[\"dev\"], split_qrels[\"test\"]\n\nDATA_ROOT = download_official_nfcorpus()\nCORPUS, ALL_QUERIES, TRAIN_QRELS, DEV_QRELS, QRELS = load_nfcorpus_splits(DATA_ROOT)\nQUERIES = {qid: ALL_QUERIES[qid] for qid in QRELS if qid in ALL_QUERIES}\n\ndef dataset_integrity_checks(corpus, queries, qrels):\n    expected = CFG[\"dataset\"][\"expected\"]\n    n_qrels = sum(len(v) for v in qrels.values())\n    qrel_qids = set(qrels)\n    qrel_docids = {doc_id for rels in qrels.values() for doc_id in rels}\n    observations = {\n        \"documents\": len(corpus), \"queries_with_test_qrels\": len(queries), \"qrels\": n_qrels,\n        \"unknown_qrel_query_ids\": len(qrel_qids - set(queries)),\n        \"unknown_qrel_document_ids\": len(qrel_docids - set(corpus)),\n        \"empty_documents\": sum(not v[\"text\"].strip() for v in corpus.values()),\n        \"empty_queries\": sum(not text.strip() for text in queries.values()),\n        \"negative_relevance_grades\": sum(grade < 0 for rels in qrels.values() for grade in rels.values()),\n        \"queries_without_positive_judgment\": sum(not any(g > 0 for g in qrels.get(qid, {}).values()) for qid in queries),\n        **{k: DATASET_IDENTITY_AUDIT[k] for k in (\"duplicate_document_identifiers\", \"duplicate_query_identifiers\", \"duplicate_query_document_judgments\")},\n    }\n    expected_values = {\n        \"documents\": expected[\"documents\"], \"queries_with_test_qrels\": expected[\"queries\"], \"qrels\": expected[\"qrels\"],\n        \"unknown_qrel_query_ids\": 0, \"unknown_qrel_document_ids\": 0, \"empty_documents\": 0,\n        \"empty_queries\": 0, \"negative_relevance_grades\": 0, \"queries_without_positive_judgment\": 0,\n        \"duplicate_document_identifiers\": 0, \"duplicate_query_identifiers\": 0,\n        \"duplicate_query_document_judgments\": 0,\n    }\n    frame = pd.DataFrame([{\"check\": k, \"observed\": v, \"expected\": expected_values[k], \"passed\": v == expected_values[k]} for k, v in observations.items()])\n    return frame\n\nDATASET_CHECKS = dataset_integrity_checks(CORPUS, QUERIES, QRELS)\ndisplay(DATASET_CHECKS)\nif not DATASET_CHECKS[\"passed\"].all():\n    save_json(RES / \"dataset_integrity_failure.json\", {\"checks\": DATASET_CHECKS.to_dict(\"records\"), \"provenance\": DATASET_PROVENANCE})\n    raise RuntimeError(\"Dataset integrity validation failed; no benchmark results will be produced.\")\nprint(\"Loaded\", len(CORPUS), \"documents;\", len(QUERIES), \"test queries;\", sum(len(v) for v in QRELS.values()), \"test qrels.\")\n\n# Split integrity is checked before the training routine begins.\ntrain_qids, dev_qids, test_qids = set(TRAIN_QRELS), set(DEV_QRELS), set(QRELS)\nall_corpus_ids, all_query_ids = set(CORPUS), set(ALL_QUERIES)\ndef split_integrity_record(split_name, split_qrels):\n    qids = set(split_qrels)\n    docids = {did for rels in split_qrels.values() for did in rels}\n    duplicate_key = \"duplicate_query_document_judgments\" if split_name == \"test\" else f\"duplicate_{split_name}_query_document_judgments\"\n    return {\n        \"split\": split_name, \"queries\": len(qids), \"qrels\": sum(len(v) for v in split_qrels.values()),\n        \"unknown_query_ids\": len(qids - all_query_ids), \"unknown_document_ids\": len(docids - all_corpus_ids),\n        \"empty_queries\": sum(not ALL_QUERIES.get(qid, \"\").strip() for qid in qids),\n        \"negative_grades\": sum(g < 0 for rels in split_qrels.values() for g in rels.values()),\n        \"queries_without_positive_judgment\": sum(not any(g > 0 for g in rels.values()) for rels in split_qrels.values()),\n        \"duplicate_qrel_rows\": DATASET_IDENTITY_AUDIT.get(duplicate_key, 0),\n    }\nSPLIT_INTEGRITY = pd.DataFrame([split_integrity_record(\"train\", TRAIN_QRELS), split_integrity_record(\"dev\", DEV_QRELS), split_integrity_record(\"test\", QRELS)])\nSPLIT_INTEGRITY[\"query_ids_disjoint\"] = [\n    train_qids.isdisjoint(dev_qids | test_qids),\n    dev_qids.isdisjoint(train_q