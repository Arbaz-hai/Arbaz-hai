s() for g in rels.values())\n\ndef distribution_stats(values, label):\n    values = np.asarray(values, dtype=float)\n    return {\"measure\": label, \"count\": int(values.size), \"mean\": float(values.mean()), \"std\": float(values.std(ddof=1)) if values.size > 1 else 0.0,\n            \"min\": float(values.min()), \"median\": float(np.median(values)), \"p95\": float(np.percentile(values, 95)), \"max\": float(values.max())}\n\nDATASET_STAT_ROWS = [\n    {\"measure\": \"documents\", \"count\": len(CORPUS), \"mean\": np.nan, \"std\": np.nan, \"min\": np.nan, \"median\": np.nan, \"p95\": np.nan, \"max\": np.nan},\n    {\"measure\": \"queries\", \"count\": len(QUERIES), \"mean\": np.nan, \"std\": np.nan, \"min\": np.nan, \"median\": np.nan, \"p95\": np.nan, \"max\": np.nan},\n    {\"measure\": \"relevance_judgments\", \"count\": sum(len(v) for v in QRELS.values()), \"mean\": np.nan, \"std\": np.nan, \"min\": np.nan, \"median\": np.nan, \"p95\": np.nan, \"max\": np.nan},\n    distribution_stats(DOC_LENGTHS, \"document_tokens\"),\n    distribution_stats(QUERY_LENGTHS, \"query_tokens\"),\n]\nDATASET_STATS = pd.DataFrame(DATASET_STAT_ROWS)\nGRADE_STATS = pd.DataFrame([{\"relevance_grade\": g, \"judgment_count\": n, \"share\": n / sum(GRADE_COUNTS.values())} for g, n in sorted(GRADE_COUNTS.items())])\ndisplay(DATASET_STATS.round(2))\ndisplay(GRADE_STATS.round(4))\nDATASET_STATS.to_csv(RES / \"dataset_statistics.csv\", index=False)\nGRADE_STATS.to_csv(RES / \"relevance_grade_distribution.csv\", index=False)\n\nfig, axes = plt.subplots(1, 2, figsize=(11, 4))\naxes[0].hist(DOC_LENGTHS, bins=40)\naxes[0].set(title=\"NFCorpus document lengths\", xlabel=\"Tokens\", ylabel=\"Documents\")\naxes[1].hist(QUERY_LENGTHS, bins=20)\naxes[1].set(title=\"NFCorpus query lengths\", xlabel=\"Tokens\", ylabel=\"Queries\")\nfig.tight_layout()\nfig.savefig(FIG / \"dataset_length_distributions.png\", dpi=300, bbox_inches=\"tight\")\nplt.close(fig)","metadata":{"trusted":true,"execution":{"iopub.st