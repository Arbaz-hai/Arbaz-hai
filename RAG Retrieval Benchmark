l\n    ram_total_bytes = int(psutil.virtual_memory().total)\n    ram_available_bytes = int(psutil.virtual_memory().available)\nexcept Exception:\n    ram_total_bytes = None\n    ram_available_bytes = None\n\ngpu_info = []\nfor i in range(torch.cuda.device_count()):\n    props = torch.cuda.get_device_properties(i)\n    gpu_info.append({\"index\": i, \"name\": props.name, \"total_memory_bytes\": int(props.total_memory),\n                     \"multi_processor_count\": int(props.multi_processor_count)})\nENVIRONMENT = {\n    \"python\": sys.version, \"python_version\": platform.python_version(), \"platform\": platform.platform(),\n    \"torch\": torch.__version__, \"transformers\": package_version(\"transformers\"),\n    \"sentence_transformers\": package_version(\"sentence-transformers\"), \"numpy\": np.__version__,\n    \"pandas\": pd.__version__, \"scipy\": package_version(\"scipy\"), \"huggingface_hub\": package_version(\"huggingface-hub\"),\n    \"rank_bm25\": package_version(\"rank-bm25\"), \"matplotlib\": package_version(\"matplotlib\"),\n    \"cuda_runtime\": torch.version.cuda, \"cudnn\": torch.backends.cudnn.version(),\n    \"gpu_count\": torch.cuda.device_count(), \"gpus\": gpu_info,\n    \"ram_total_bytes\": ram_total_bytes, \"ram_available_at_manifest_bytes\": ram_available_bytes,\n    \"run_started_utc\": RUN_STARTED_UTC,\n    \"run_finished_manifest_utc\": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec=\"seconds\"),\n    \"dataset_provenance\": DATASET_PROVENANCE,\n    \"dense_encoder_sequence_length\": DENSE_SEQUENCE_LENGTH,\n    \"generator_input_limit\": TOK_LIMIT,\n}\nsave_json(RES / \"environment.json\", ENVIRONMENT)\n\nrun_fingerprint_payload = {\n    \"seed\": SEED, \"dataset_md5\": DATASET_PROVENANCE.get(\"archive_md5\"),\n    \"models\": {k: v[\"resolved_commit_sha\"] for k, v in MODEL_REVISIONS.items()},\n    \"dense_encoder_training\": {\"best_epoch\": best_epoch, \"best_dev_ndcg_at_10\": best_dev_ndcg, \"checkpoint_weight_sha256\": checkpoint_hashes},\n    \"config\": CFG, \"generation_conditions\": GEN_CONDITIONS, \"sample_ids\": SAMPLE_IDS,\n}\nRUN_FINGERPRINT = hashlib.sha256(json.dumps(run_fingerprint_payload, sort_keys=True, default=str).encode(\"utf-8\")).hexdigest()\nsave_json(RES / \"run_manifest.json\", {\n    \"run_started_utc\": RUN_STARTED_UTC, \"run_manifest_written_utc\": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec=\"seconds\"),\n    \"run_fingerprint_sha256\": RUN_FINGERPRINT, \"seed\": SEED, \"config\": CFG,\n    \"dataset_provenance\": DATASET_PROVENANCE, \"model_revisions\": {k: v[\"resolved_commit_sha\"] for k, v in MODEL_REVISIONS.items()},\n    \"dense_encoder_training\": TRAINING_RECORD,\n    \"retrieval_configuration_count\": len(RETRIEVAL_RESULTS), \"retrieval_query_count_per_configuration\": len(QUERY_IDS),\n    \"generation_configuration_count\": len(GEN_CONDITIONS), \"generation_query_sample_ids\": SAMPLE_IDS,\n    \"generation_output_rows\": len(FINAL_OUTPUT_ROWS), \"generation_attempt_rows\": len(ATTEMPT_ROWS),\n    \"generator_runtime\": GENERATOR_INFO, \"nli_runtime\": NLI_INFO,\n    \"training_protocol\": \"Dense bi-encoder fine-tuning used NFCorpus train qrels; dev qrels selected the inference checkpoint; test qrels were held out.\",\n    \"measurement_boundaries\": {\n        \"bm25\": \"sequential query scoring, excludes index construction\",\n        \"dense\": \"batch-amortized query encoding plus exact per-query search, excludes dense index construction\",\n        \"hybrid\": \"BM25 + dense + RRF query latency; excludes index construction\",\n        \"reranked\": \"first-stage query latency plus separately measured cross-encoder reranking time\",\n        \"generation\": \"per-output wall-clock latency; includes the recovery attempt when one was used\",\n    },\n    \"single_run_single_seed\": True,\n})\n\nrepro_lines = [\n    \"# Reproducibility report\", \"\",\n    f\"- Run started (UTC): {RUN_STARTED_UTC}\", f\"- Run fingerprint SHA-256: `{RUN_FINGERPRINT}`\",\n    f\"- Dataset archive MD5: `{DATASET_PROVENANCE.get('archive_md5')}`\", \"- Dataset splits: train for dense encoder fine-tuning, dev for checkpoint selection, test held out for final evaluation\",\n    f\"- Observed test-set counts: {len(CORPUS)} documents, {len(QUERIES)} queries, {sum(len(v) for v in QRELS.values())} judgments.\",\n    \"- Four public models were downloaded using full immutable repository commit SHAs. These are new-run pins, not recovered revisions for the historical experiment.\",\n    \"- Dense retrieval uses L2-normalized embeddings and exact inner-product search.\",\n    \"- Retrieval effectiveness is macro-averaged over all test queries. Pairwise CIs use paired query resampling.\",\n    \"- Generation uses a fixed 100-query sample shared by all 3 conditions, deterministic four-beam decoding, FP32, no autocast, and up to two logged recovery attempts (same evidence, different pre-declared prompt wrappers).\",\n    f\"- Dense bi-encoder fine-tuning used {len(TRAIN_PAIRS)} train-only query-document pairs over {len(TRAIN_HISTORY)-1} epochs; selected checkpoint epoch (baseline=0): {best_epoch}; dev nDCG@10={best_dev_ndcg:.6f}.\",\n    \"- Test qrels were not used for training or checkpoint selection. The reranker, generator, and NLI evaluator remain pretrained.\",\n    \"- One seed and one run were used. Bootstrap intervals estimate variation across sampled queries only, not run-to-run variance.\",\n    \"\", \"## Model revisions\", \"\",\n]\nfor role, record in MODEL_REVISIONS.items():\n    repro_lines.append(f\"- **{role}:** `{record['repo_id']}` @ `{record['resolved_commit_sha']}`; local weight SHA-256: `{json.dumps(record['local_weight_sha256'])}`\")\nrepro_lines += [\"\", \"## Runtime versions\", \"\", \"```json\", json.dumps(ENVIRONMENT, indent=2, default=str), \"```\", \"\"]\n(REP / \"reproducibility_report.md\").write_text(\"\\n\".join(repro_lines), encoding=\"utf-8\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-03T07:23:16.861801Z","iopub.execute_input":"2026-11-03T07:23:16.862179Z","iopub.status.idle":"2026-11-03T07:23:16.908258Z","shell.execute_reply.started":"2026-11-03T07:23:16.862156Z","shell.execute_reply":"2026-11-03T07:23:16.907615Z"}},"outputs":[{"execution_count":22,"output_type":"execute_result","data":{"text/plain":"4138"},"metadata":{}}],"execution_count":22},{"id":"cell-047","cell_type":"markdown","source":"## 24. Generation evaluation and failure-analysis reports\n\nThe reports are generated from the current run's actual outputs. They include invalid/empty answers rather than hiding them, and label automatic metrics as proxies. No reference biomedical answers are available in NFCorpus, so exact answer accuracy is not calculated.","metadata":{}},{"id":"cell-048","cell_type":"code","source":"def markdown_table(frame, max_rows=100):\n    if frame is None or frame.empty:\n        return \"(no evaluable rows)\"\n    view = frame.head(max_rows).copy()\n    return view.to_markdown(index=False)\n\nGENERATION_EVAL_REPORT = [\n    \"# Generation evaluation report\", \"\",\n    f\"Run fingerprint: `{RUN_FINGERPRINT}`\", \"\",\n    \"## Generation outcomes\", markdown_table(GENERATION_METRICS_SUMMARY.round(4)), \"\",\n    \"## NLI evidence-support proxy\", markdown_table(FAITHFULNESS_SUMMARY.round(4)), \"\",\n    \"## Query-answer relevance proxies\", \n    markdown_table(GENERATION_METRICS_SUMMARY[[\"condition\", \"mean_query_answer_embedding_cosine\", \"mean_query_answer_cross_encoder_score\"]].round(4)), \"\",\n    \"## Paired comparisons\", markdown_table(GENERATION_PAIRED.round(4)), \"\",\n    \"## Interpretation constraints\",\n    \"- NLI entailment is an evidence-support proxy, not proof of factual correctness, biomedical validity, or clinical safety.\",\n    \"- Embedding cosine and MS MARCO cross-encoder scores are query-answer relevance proxies, not reference-answer accuracy.\",\n    \"- NFCorpus supplies document relevance judgments, not reference answers for exact answer-accuracy scoring.\",\n    \"- Empty and invalid outputs are counted as failures. They are not replaced by templates and do not receive invented scores.\",\n    \"- Abstentions are reported separately. Answers with no eligible claims receive missing evidence-support scores, not zero.\",\n    \"- The human-evaluation CSV is an empty reviewer template, not completed human evaluation.\",\n    \"- The single-run confidence intervals describe per-query variation, not repeated-run variance.\", \"\",\n    \"- Calibration keyword controls are diagnostics only. A failed keyword match is retained as a model limitation and is not treated as biomedical accuracy.\",\n    \"- If calibration keyword controls fail, inspect `calibration_control_outputs.csv`; do not interpret a structurally valid answer as proven correct.\",\n]\n(REP / \"generation_evaluation_report.md\").write_text(\"\\n\".join(GENERATION_EVAL_REPORT), encoding=\"utf-8\")\n\nfailure_counts = GENERATION_OUTPUTS.groupby([\"condition\", \"status\"]).size().unstack(fill_value=0).to_dict(orient=\"index\")\nscore_failures = int((~GENERATION_ATTEMPTS[\"score_checks_passed\"].fillna(False)).sum())\ninvalid_frame = GENERATION_OUTPUTS[GENERATION_OUTPUTS.status != STATUS_COMPLETED].copy()\ninvalid_frame[\"answer_preview\"] = invalid_frame[\"answer\"].fillna(\"\").astype(str).str.slice(0, 1000)\ninvalid_reasons = invalid_frame[[\n    \"condition\", \"query_id\", \"status\", \"final_attempt_number\", \"recovery_used\",\n    \"invalid_reason\", \"error\", \"answer_preview\",\n]]\nFAILURE_REPORT = [\n    \"# Failure analysis\", \"\",\n    \"## Per-condition final output status counts\", \"```json\", json.dumps(failure_counts, indent=2, default=str), \"```\", \"\",\n    f\"- Generation attempts (including recovery calls): {len(GENERATION_ATTEMPTS)}\",\n    f\"- Attempts with invalid score tensors or score values: {score_failures}\",\n    f\"- Recovery attempts: {int(GENERATION_ATTEMPTS.recovery.fillna(False).sum())}\",\n    \"\", \"## Invalid or failed final outputs\", markdown_table(invalid_reasons, max_rows=300), \"\",\n    \"## Notes\", \n    \"- A final output is successful only when it is non-empty, avoids exact query/prompt and metadata echoes, is not a generic placeholder, and passes generation-score integrity checks. Factual answers must meet the configured word minimum; a clearly phrased, complete evidence-insufficient abstention is valid even when shorter. Diagnostic calibration controls use a separate one-word minimum.\",\n    \"- An invalid first attempt receives up to two recovery calls using the same evidence. If the last attempt is still invalid, the output remains invalid.\",\n    \"- No fallback answer is inserted. Failures are preserved in `generation_attempts.csv` and `generation_outputs.csv`.\",\n    \"- The prior manuscript's 300 blank outputs are historical context only; they are not reused as new-run observations.\", \"\",\n]\n(REP / \"failure_analysis.md\").write_text(\"\\n\".join(FAILURE_REPORT), encoding=\"utf-8\")\ninvalid_reasons.to_csv(RES / \"generation_failure_details.csv\", index=False)\n\nREADME_TEXT = f\"\"\"# Biomedical RAG Benchmark Results\n\nThis directory contains the outputs of a fresh, deterministic benchmark run on the BEIR NFCorpus test split.\n\n- Dataset: BEIR NFCorpus test split; corpus, queries, and qrels counts are recorded in `results/dataset_statistics.csv`.\n- Retrieval: 3 chunking strategies × 3 first-stage retrievers × 2 reranking states (18 configurations).\n- Generation: 3 fixed RAG conditions over one shared seeded sample of 100 test queries.\n- Models: immutable Hub commit SHAs and weight hashes are in `results/model_revisions.json`.\n- Reproducibility: exact runtime, dataset provenance, configuration, and run fingerprint are stored under `results/`.\n- Reports: generation evaluation, reproducibility, and failure analysis are in `reports/`.\n- Figures: publication-quality PNG files are in `figures/`.\n\nThe dense bi-encoder is fine-tuned on train qrels and selected using dev nDCG@10; test qrels are held out. NLI and query-answer similarity measures are proxies, not clinical correctness or reference-answer accuracy. Empty and invalid generations are never replaced with template text. The final ZIP is only created when the automated validations pass.\n\nRun fingerprint: `{RUN_FINGERPRINT}`\n\"\"\"\n(OUT / \"README.md\").write_text(README_TEXT, encoding=\"utf-8\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-03T07:23:16.909213Z","iopub.execute_input":"2026-11-03T07:23:16.909534Z","iopub.status.idle":"2026-11-03T07:23:16.950112Z","shell.execute_reply.started":"2026-11-03T07:23:16.909513Z","shell.execute_reply":"2026-11-03T07:23:16.949412Z"}},"outputs":[{"execution_count":23,"output_type":"execute_result","data":{"text/plain":"1259"},"metadata":{}}],"execution_count":23},{"id":"cell-049","cell_type":"markdown","source":"## 25. Automated validation\n\nValidation checks the benchmark dimensions, provenance, output completeness, prompt limits, score integrity, evidence provenance, CSV/JSON readability, figure creation, and required reports. The notebook does not print a success message or create a final ZIP if any required technical or scientific validation check fails. Failed/empty generation outputs are therefore visible failures, not silently counted as successes.","metadata":{}},{"id":"cell-050","cell_type":"code","source":"REQUIRED_RESULT_FILES = [\n    \"config.json\", \"dataset_statistics.csv\", \"relevance_grade_distribution.csv\", \"chunking_statistics.csv\",\n    \"retrieval_results.csv\", \"retrieval_metrics_per_query.csv\", \"retrieval_rankings.jsonl\", \"retrieval_pairwise_comparisons.csv\",\n    \"retrieval_condition_configuration.csv\", \"generation_configuration.csv\", \"generation_sample.json\",\n    \"generation_outputs.csv\", \"generation_outputs.jsonl\", \"generation_attempts.csv\", \"generation_attempts.jsonl\", \"generation_failure_details.csv\",\n    \"generation_diagnostics.csv\", \"generation_metrics_per_query.csv\", \"generation_metrics_summary.csv\",\n    \"faithfulness_claims.csv\", \"faithfulness_summary.csv\", \"answer_relevance.csv\", \"human_evaluation_template.csv\",\n    \"calibration_control_outputs.csv\", \"nli_calibration_controls.csv\", \"model_revisions.json\", \"model_provenance.csv\",\n    \"dense_encoder_training_history.csv\", \"dense_encoder_training_config.json\", \"dense_encoder_training_summary.json\",\n    \"train_dev_split_integrity.csv\", \"environment.json\",\n    \"run_manifest.json\", \"validation_report.json\",\n]\nREQUIRED_FIGURE_FILES = [\n    \"dataset_length_distributions.png\", \"retrieval_metric_comparison.png\", \"recall_at_10_comparison.png\",\n    \"ndcg_mrr_comparison.png\", \"generation_success_rate.png\", \"answer_length_distribution.png\",\n    \"evidence_support_comparison.png\", \"query_answer_relevance.png\", \"generation_latency_comparison.png\",\n    \"supported_vs_unsupported_claims.png\", \"dense_encoder_training_loss.png\",\n]\nREQUIRED_REPORT_FILES = [\"generation_evaluation_report.md\", \"reproducibility_report.md\", \"failure_analysis.md\"]\n\ndef validation_check(checks, name, condition, detail):\n    checks.append({\"check\": name, \"passed\": bool(condition), \"detail\": str(detail)})\n\nVALIDATION_CHECKS = []\nvalidation_check(VALIDATION_CHECKS, \"dataset_dimensions\", len(CORPUS) == 3633 and len(QUERIES) == 323 and sum(len(v) for v in QRELS.values()) == 12334,\n                 f\"documents={len(CORPUS)}, queries={len(QUERIES)}, qrels={sum(len(v) for v in QRELS.values())}\")\nvalidation_check(VALIDATION_CHECKS, \"train_dev_test_query_ids_disjoint\", train_qids.isdisjoint(dev_qids | test_qids) and dev_qids.isdisjoint(test_qids),\n                 f\"train={len(train_qids)}, dev={len(dev_qids)}, test={len(test_qids)}\")\nvalidation_check(VALIDATION_CHECKS, \"dense_encoder_training_completed\", len(TRAIN_HISTORY