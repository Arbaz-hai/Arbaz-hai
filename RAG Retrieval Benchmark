    <th>condition</th>\n      <th></th>\n      <th></th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>C1_fixed128_bm25</th>\n      <td>0.4246</td>\n      <td>-3.8213</td>\n      <td>0.8271</td>\n      <td>3.15</td>\n    </tr>\n    <tr>\n      <th>C2_fixed256o32_hybrid</th>\n      <td>0.4607</td>\n      <td>-4.0809</td>\n      <td>0.8710</td>\n      <td>2.00</td>\n    </tr>\n    <tr>\n      <th>C3_fixed256o32_hybrid_rerank</th>\n      <td>0.4845</td>\n      <td>-2.6655</td>\n      <td>0.8784</td>\n      <td>2.03</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":19},{"id":"cell-041","cell_type":"markdown","source":"## 21. Generation metrics and statistical comparison\n\nCompletion, empty-output, invalid-output, and failure rates use all 100 sampled queries per condition as the denominator. Answer length and automatic proxies are calculated only where they are evaluable. Abstentions are counted separately. Claims without an eligible claim or evidence passage are not assigned a zero support score.","metadata":{}},{"id":"cell-042","cell_type":"code","source":"RELEVANCE_LOOKUP = {(r[\"condition\"], r[\"query_id\"]): r for r in relevance_rows}\nFAITHFULNESS_BY_ANSWER = {}\nif len(FAITHFULNESS_CLAIMS):\n    for (condition_id, qid), frame in FAITHFULNESS_CLAIMS.groupby([\"condition\", \"query_id\"]):\n        FAITHFULNESS_BY_ANSWER[(condition_id, qid)] = {\n            \"evaluable_claims\": len(frame), \"supported_claims\": int(frame[\"supported\"].sum()),\n            \"unsupported_claims\": int((~frame[\"supported\"]).sum()),\n            \"evidence_support\": float(frame[\"supported\"].mean()),\n            \"mean_entailment\": float(frame[\"max_entailment_probability\"].mean()),\n        }\n\nGENERATION_METRIC_ROWS = []\nfor row in FINAL_OUTPUT_ROWS:\n    key = (row[\"condition\"], row[\"query_id\"])\n    ans_words = len(WORD_RE.findall(row[\"answer\"] or \"\")) if row[\"answer_valid\"] else np.nan\n    faith = FAITHFULNESS_BY_ANSWER.get(key, {})\n    rel = RELEVANCE_LOOKUP.get(key, {})\n    evidence_texts = [e[\"text\"] for e in row[\"evidence\"]]\n    GENERATION_METRIC_ROWS.append({\n        \"condition\": row[\"condition\"], \"query_id\": row[\"query_id\"], \"status\": row[\"status\"],\n        \"answer_valid\": bool(row[\"answer_valid\"]), \"is_abstention\": bool(ABSTENTION_PATTERN.search(row[\"answer\"] or \"\")),\n        \"answer_words\": ans_words if row[\"answer\"] else np.nan, \"generation_latency_ms\": row[\"latency_ms\"],\n        \"evaluable_claims\": faith.get(\"evaluable_claims\", 0), \"supported_claims\": faith.get(\"supported_claims\", 0),\n        \"unsupported_claims\": faith.get(\"unsupported_claims\", 0), \"evidence_support\": faith.get(\"evidence_support\", np.nan),\n        \"mean_claim_entailment\": faith.get(\"mean_entailment\", np.nan),\n        \"query_answer_embedding_cosine\": rel.get(\"query_answer_embedding_cosine\", np.nan),\n        \"query_answer_cross_encoder_score\": rel.get(\"query_answer_cross_encoder_score\", np.nan),\n        \"fourgram_copy_ratio\": rel.get(\"fourgram_copy_ratio\", np.nan),\n        \"n_evidence_passages\": len(row[\"evidence\"]),\n    })\nGENERATION_METRICS_PER_QUERY = pd.DataFrame(GENERATION_METRIC_ROWS)\nGENERATION_METRICS_PER_QUERY.to_csv(RES / \"generation_metrics_per_query.csv\", index=False)\n\nsummary_rows = []\nfor condition in [c[\"id\"] for c in GEN_CONDITIONS]:\n    frame = GENERATION_METRICS_PER_QUERY[GENERATION_METRICS_PER_QUERY.condition == condition]\n    total = len(frame)\n    n_completed = int((frame.status == STATUS_COMPLETED).sum())\n    n_empty = int((frame.status == STATUS_EMPTY).sum())\n    n_invalid = int((frame.status == STATUS_INVALID).sum())\n    n_failed = int((frame.status == STATUS_FAILED).sum())\n    summary_rows.append({\n        \"condition\": condition, \"n_queries\": total, \"completed_answers\": n_completed,\n        \"empty_outputs\": n_empty, \"invalid_outputs\": n_invalid, \"failed_generations\": n_failed,\n        \"completion_rate\": n_completed / total if total else np.nan,\n        \"empty_output_rate\": n_empty / total if total else np.nan,\n        \"invalid_output_rate\": n_invalid / total if total else np.nan,\n        \"generation_failure_rate\": n_failed / total if total else np.nan,\n        \"mean_answer_words\": frame.answer_words.mean(), \"median_answer_words\": frame.answer_words.median(),\n        \"mean_generation_latency_ms\": frame.generation_latency_ms.mean(),\n        \"n_answers_with_evaluable_claims\": int(frame.evaluable_claims.gt(0).sum()),\n        \"total_evaluable_claims\": int(frame.evaluable_claims.sum()),\n        \"supported_claims\": int(frame.supported_claims.sum()), \"unsupported_claims\": int(frame.unsupported_claims.sum()),\n        \"claim_level_support_rate\": frame.supported_claims.sum() / frame.evaluable_claims.sum() if frame.evaluable_claims.sum() else np.nan,\n        \"mean_evidence_support\": frame.evidence_support.mean(),\n        \"abstention_count\": int(frame.is_abstention.sum()), \"abstention_rate\": float(frame.is_abstention.mean()) if total else np.nan,\n        \"mean_query_answer_embedding_cosine\": frame.query_answer_embedding_cosine.mean(),\n        \"mean_query_answer_cross_encoder_score\": frame.query_answer_cross_encoder_score.mean(),\n        \"mean_fourgram_copy_ratio\": frame.fourgram_copy_ratio.mean(),\n    })\nGENERATION_METRICS_SUMMARY = pd.DataFrame(summary_rows)\nGENERATION_METRICS_SUMMARY.to_csv(RES / \"generation_metrics_summary.csv\", index=False)\ndisplay(GENERATION_METRICS_SUMMARY.round(4))\n\n# Pairwise generation comparisons use the common sample and available paired rows.\ndef compare_generation_metric(metric, condition_a, condition_b, seed_offset=0):\n    a = GENERATION_METRICS_PER_QUERY[GENERATION_METRICS_PER_QUERY.condition == condition_a][[\"query_id\", metric]]\n    b = GENERATION_METRICS_PER_QUERY[GENERATION_METRICS_PER_QUERY.condition == condition_b][[\"query_id\", metric]]\n    pair = a.merge(b, on=\"query_id\", suffixes=(\"_a\", \"_b\"), validate=\"one_to_one\").dropna()\n    diff = (pair[f\"{metric}_b\"] - pair[f\"{metric}_a\"]).to_numpy(dtype=float)\n    if len(diff) == 0:\n        lo = hi = p = dz = np.nan\n    else:\n        lo, hi = paired_bootstrap_ci(diff, CFG[\"bootstrap\"][\"n_resamples\"], SEED + seed_offset, CFG[\"bootstrap\"][\"alpha\"])\n        p = float(scipy_stats.wilcoxon(diff, zero_method=\"wilcox\").pvalue) if np.any(diff != 0) else 1.0\n        dz = float(diff.mean() / diff.std(ddof=1)) if len(diff) > 1 and diff.std(ddof=1) > 0 else 0.0\n    return {\"metric\": metric, \"A\": condition_a, \"B\": condition_b, \"n_paired\": len(diff),\n            \"mean_diff_B_minus_A\": float(diff.mean()) if len(diff) else np.nan,\n            \"ci95_lower\": float(lo), \"ci95_upper\": float(hi), \"wilcoxon_p\": p, \"cohens_dz\": dz,\n            \"wins_B\": int((diff > 0).sum()), \"losses_B\": int((diff < 0).sum()), \"ties\": int((diff == 0).sum())}\n\nGEN_PAIR_ROWS = []\ncondition_ids = [c[\"id\"] for c in GEN_CONDITIONS]\nfor metric in (\"evidence_support\", \"query_answer_embedding_cosine\", \"query_answer_cross_encoder_score\", \"answer_words\"):\n    for i in range(len(condition_ids)):\n        for j in range(i + 1, len(condition_ids)):\n            GEN_PAIR_ROWS.append(compare_generation_metric(metric, condition_ids[i], condition_ids[j], len(GEN_PAIR_ROWS)))\nGENERATION_PAIRED = pd.DataFrame(GEN_PAIR_ROWS)\nGENERATION_PAIRED[\"holm_adjusted_p\"] = np.nan\nfor metric, index in GENERATION_PAIRED.groupby(\"metric\").groups.items():\n    valid = [i for i in index if np.isfinite(GENERATION_PAIRED.loc[i, \"wilcoxon_p\"])]\n    if valid:\n        GENERATION_PAIRED.loc[valid, \"holm_adjusted_p\"] = holm_adjust(GENERATION_PAIRED.loc[valid, \"wilcoxon_p\"].tolist())\nGENERATION_PAIRED.to_csv(RES / \"generation_paired_comparisons.csv\", index=False)\ndisplay(GENERATION_PAIRED.round(4))\n\n# Human asse