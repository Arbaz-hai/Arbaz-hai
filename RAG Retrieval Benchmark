device=relevance_device)\nrelevance_encoder.max_seq_length = DENSE_SEQUENCE_LENGTH\nrelevance_cross_encoder = CrossEncoder(MODEL_PATHS[\"reranker\"], device=relevance_device,\n                                        max_length=CFG[\"retrieval\"][\"cross_encoder_max_length\"], trust_remote_code=False)\n\ndef fourgram_copy_ratio(answer, evidence_texts):\n    answer_tokens = [x.casefold() for x in WORD_RE.findall(answer or \"\")]\n    evidence_tokens = [x.casefold() for x in WORD_RE.findall(\" \".join(evidence_texts))]\n    if len(answer_tokens) < 4:\n        return np.nan\n    answer_grams = [tuple(answer_tokens[i:i + 4]) for i in range(len(answer_tokens) - 3)]\n    evidence_grams = set(tuple(evidence_tokens[i:i + 4]) for i in range(max(0, len(evidence_tokens) - 3)))\n    return sum(gram in evidence_grams for gram in answer_grams) / len(answer_grams)\n\nVALID_OUTPUTS = [r for r in FINAL_OUTPUT_ROWS if r[\"status\"] == STATUS_COMPLETED and r[\"answer_valid\"]]\nrelevance_rows = []\nif VALID_OUTPUTS:\n    q_texts = [r[\"query\"] for r in VALID_OUTPUTS]\n    a_texts = [r[\"answer\"] for r in VALID_OUTPUTS]\n    q_vectors = relevance_encoder.encode(q_texts, batch_size=64, convert_to_numpy=True, normalize_embeddings=True, show_progress_bar=True)\n    a_vectors = relevance_encoder.encode(a_texts, batch_size=64, convert_to_numpy=True, normalize_embeddings=True, show_progress_bar=True)\n    cosine_scores = np.sum(q_vectors * a_vectors, axis=1)\n    ce_pairs = [(r[\"query\"], r[\"answer\"]) for r in VALID_OUTPUTS]\n    ce_scores = np.asarray(relevance_cross_encoder.predict(ce_pairs, batch_size=64, convert_to_numpy=True, show_progress_bar=True), dtype=float).reshape(-1)\n    if len(ce_scores) != len(VALID_OUTPUTS) or not np.isfinite(ce_scores).all():\n        raise RuntimeError(\"Cross-encoder answer-relevance scores are malformed or non-finite\")\n    for row, cosine, cross_score in zip(VALID_OUTPUTS, cosine_scores, ce_scores):\n        relevance_rows.append({\n            \"condition\": row[\"condition\"], \"query_id\": row[\"query_id\"],\n            \"query_answer_embedding_cosine\": float(cosine), \"query_answer_cross_encoder_score\": float(cross_score),\n            \"fourgram_copy_ratio\": fourgram_copy_ratio(row[\"answer\"], [e[\"text\"] for e in row[\"evidence\"]]),\n            \"n_evidence_passages\": len(row[\"evidence\"]),\n        })\nANSWER_RELEVANCE = pd.DataFrame(relevance_rows, columns=[\n    \"condition\", \"query_id\", \"query_answer_embedding_cosine\", \"query_answer_cross_encoder_score\",\n    \"fourgram_copy_ratio\", \"n_evidence_passages\",\n])\nANSWER_RELEVANCE.to_csv(RES / \"answer_relevance.csv\", index=False)\ndisplay(ANSWER_RELEVANCE.groupby(\"condition\").mean(numeric_only=True).round(4) if len(ANSWER_RELEVANCE) else ANSWER_RELEVANCE)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-03T07:23:12.690012Z","iopub.execute_input":"2026-11-03T07:23:12.690753Z","iopub.status.idle":"2026-11-03T07:23:14.381554Z","shell.execute_reply.started":"2026-11-03T07:23:12.690715Z","shell.execute_reply":"2026-11-03T07:23:14.380875Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/103 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"4f7f23ad26ba4f868d906bd5b6372d1b"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/105 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"b313f8ee8baa4286ac45ba751c710262"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Batches:   0%|          | 0/5 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"8843ab57b64b45e49b62529bf3e18ec1"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Batches:   0%|          | 0/5 [00:00<?, ?it/s]","application/vnd.jupyter.widge