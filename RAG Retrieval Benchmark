d>C2_fixed256o32_hybrid</td>\n      <td>C3_fixed256o32_hybrid_rerank</td>\n      <td>100</td>\n      <td>-0.3800</td>\n      <td>-2.3700</td>\n      <td>1.5700</td>\n      <td>0.8226</td>\n      <td>-0.0379</td>\n      <td>32</td>\n      <td>32</td>\n      <td>36</td>\n      <td>1.0000</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":20},{"id":"cell-043","cell_type":"markdown","source":"## 22. Final tables and figures\n\nThe figures below are generated only from outputs and metrics produced in this run. Empty/invalid generations remain in completion denominators and are not assigned fabricated quality scores. The NLI support figure uses only answers with at least one evaluable claim.","metadata":{}},{"id":"cell-044","cell_type":"code","source":"# Generation diagnostics table: one row per status/condition and score-integrity result.\nGEN_DIAGNOSTICS_ROWS = []\nfor condition in condition_ids:\n    frame = GENERATION_OUTPUTS[GENERATION_OUTPUTS.condition == condition]\n    attempts = GENERATION_ATTEMPTS[GENERATION_ATTEMPTS.condition == condition]\n    GEN_DIAGNOSTICS_ROWS.append({\n        \"condition\": condition, \"final_rows\": len(frame),\n        \"completed\": int((frame.status == STATUS_COMPLETED).sum()),\n        \"empty\": int((frame.status == STATUS_EMPTY).sum()),\n        \"invalid\": int((frame.status == STATUS_INVALID).sum()),\n        \"failed\": int((frame.status == STATUS_FAILED).sum()),\n        \"attempt_rows\": len(attempts), \"recovery_attempts\": int(attempts.recovery.fillna(False).sum()),\n        \"score_check_failures\": int((~attempts.score_checks_passed.fillna(False)).sum()),\n        \"prompt_over_limit_attempts\": int((attempts.input_tokens > TOK_LIMIT).sum()),\n    })\nGEN_DIAGNOSTICS = pd.DataFrame(GEN_DIAGNOSTICS_ROWS)\nGEN_DIAGNOSTICS.to_csv(RES / \"generation_diagnostics.csv\", index=False)\ndisplay(GEN_DIAGNOSTICS)\n\n# Completion/success-rate plot.\nfig, ax = plt.subplots(figsize=(8, 5))\nplot_gen = GENERATION_METRICS_SUMMARY.set_index(\"condition\").reindex(condition_ids)\nax.bar(condition_ids, plot_gen[\"completion_rate\"] * 100, label=\"Valid completed\")\nax.set_ylim(0, 100)\nax.set_ylabel(\"Valid completion rate (%)\")\nax.set_title(\"Generation success rate by condition\")\nax.tick_params(axis=\"x\", rotation=20)\nfig.tight_layout()\nfig.savefig(FIG / \"generation_success_rate.png\", dpi=300, bbox_inches=\"tight\")\nplt.close(fig)\n\n# Answer-length distribution among nonempty valid answers.\nfig, ax = plt.subplots(figsize=(8, 5))\nlength_data = [GENERATION_METRICS_PER_QUERY.loc[(GENERATION_METRICS_PER_QUERY.condition == c) & GENERATION_METRICS_PER_QUERY.answer_words.notna(), \"answer_words\"].values for c in condition_ids]\nax.boxplot(length_data, tick_labels=condition_ids, showfliers=False)\nax.set_ylabel(\"Answer length (words)\")\nax.set_title(\"Answer-length distribution\")\nax.tick_params(axis=\"x\", rotation=20)\nfig.tight_layout()\nfig.savefig(FIG / \"answer_length_distribution.png\", dpi=300, bbox_inches=\"tight\")\nplt.close(fig)\n\n# Evidence-support comparison.\nfig, ax = plt.subplots(figsize=(8, 5))\nmeans = [GENERATION_METRICS_PER_QUERY.loc[GENERATION_METRICS_PER_QUERY.condition == c, \"evidence_support\"].mean() for c in condition_ids]\ncounts = [GENERATION_METRICS_PER_QUERY.loc[(GENERATION_METRICS_PER_QUERY.condition == c) & GENERATION_METRICS_PER_QUERY.evidence_support.notna()].shape[0] for c in condition_ids]\nax.bar(condition_ids, means)\nax.set_ylim(0, 1)\nax.set_ylabel(\"Mean claim-level support proxy\")\nax.set_title(\"Evidence-support comparison (NLI proxy)\")\nax.tick_params(axis=\"x\", rotation=20)\nfor x, (m, n) in enumerate(zip(means, counts)):\n    if np.isfinite(m):\n        ax.text(x, m + 0.02, f\"n={n}\", ha=\"center\", fontsize=8)\nfig.tight_layout()\nfig.savefig(FIG / \"evidence_support_comparison.png\", dpi=300, bbox_inches=\"tight\")\nplt.close(fig)\n\n# Query-answer relevance comparison.\nfig, ax = plt.subplots(figsize=(8, 5))\nrelevance_means = [GENERATION_METRICS_PER_QUERY.loc[GENERATION_METRICS_PER_QUERY.condition == c, \"query_answer_embedding_cosine\"].mean() for c in condition_ids]\nax.bar(condition_ids, relevance_means)\nax.set_ylabel(\"Mean embedding cosine similarity\")\nax.set_title(\"Query-answer relevance proxy\")\nax.tick_params(axis=\"x\", rotation=20)\nfig.tight_layout()\nfig.savefig(FIG / \"query_answer_relevance.png\", dpi=300, bbox_inches=\"tight\")\nplt.close(fig)\n\n# Generation latency comparison.\nfig, ax = plt.subplots(figsize=(8, 5))\nlatency_means = [GENERATION_METRICS_PER_QUERY.loc[GENERATION_METRICS_PER_QUERY.condition == c, \"generation_latency_ms\"].mean() for c in condition_ids]\nax.bar(condition_ids, latency_means)\nax.set_ylabel(\"Mean generation latency (ms; includes recovery if used)\")\nax.set_title(\"Generation latency comparison\")\nax.tick_params(axis=\"x\", rotation=20)\nfig.tight_layout()\nfig.savefig(FIG / \"generation_latency_comparison.png\", dpi=300, bbox_inches=\"tight\")\nplt.close(fig)\n\n# Supported versus unsupported claim counts.\nfig, ax = plt.subplots(figsize=(8, 5))\nsummary_plot = FAITHFULNESS_SUMMARY.set_index(\"condition\").reindex(condition_ids).fillna(0)\nax.bar(condition_ids, summary_plot.get(\"supported_claims\", pd.Series(0, index=condition_ids)), label=\"Supported\")\nax.bar(condition_ids, summary_plot.get(\"unsupported_claims\", pd.Series(0, index=condition_ids)),\n       bottom=summary_plot.get(\"supported_claims\", pd.Series(0, index=condition_ids)), label=\"Unsupported\")\nax.set_ylabel(\"Evaluable claims\")\nax.set_title(\"Supported versus unsupported claims\")\nax.tick_params(axis=\"x\", rotation=20)\nax.legend()\nfig.tight_layout()\nfig.savefig(FIG / \"supported_vs_unsupported_claims.png\", dpi=300, bbox_inches=\"tight\")\nplt.close(fig)\n\n# Save an explicit configuration/provenance table and generation outputs as requested.\nretrieval_config_table = RETRIEVAL_RESULTS[[\"config_id\", \"chunking\", \"first_stage_retrieval\", \"reranking\", \"n_queries\", \"mean_query_latency_ms\"]]\nretrieval_config_table.to_csv(RES / \"retrieval_condition_configuration.csv\", index=False)\nGENERATION_CONFIG_TABLE.to_csv(RES / \"generation_configuration.csv\", index=False)\nprint(\"Saved figures:\", sorted(p.name for p in FIG.glob(\"*.png\")))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-03T07:23:14.770786Z","iopub.execute_input":"2026-11-03T07:23:14.771235Z","iopub.status.idle":"2026-11-03T07:23:16.86066Z","shell.execute_reply.started":"2026-11-03T07:23:14.771197Z","shell.execute_reply":"2026-11-03T07:23:16.859945Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"                      condition  final_rows  completed  empty  invalid  \\\n0              C1_fixed128_bm25         100        100      0        0   \n1         C2_fixed256o32_hybrid         100        100      0        0   \n2  C3_fixed256o32_hybrid_rerank         100        100      0        0   \n\n   failed  attempt_rows  recovery_attempts  score_check_failures  \\\n0       0           100                  0                     0   \n1       0           100                  0                     0   \n2       0           101                  1                     0   \n\n   prompt_over_limit_attempts  \n0                           0  \n1                           0  \n2                           0  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>condition</th>\n      <th>final_rows</th>\n      <th>completed</th>\n      <th>empty</th>\n      <th>invalid</th>\n      <th>failed</th>\n      <th>attempt_rows</th>\n      <th>recovery_attempts</th>\n      <th>score_c